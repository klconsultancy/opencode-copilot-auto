{
  "name": "@klconsultancy/opencode-copilot-auto",
  "version": "1.0.0",
  "description": "GitHub Copilot's Auto model for opencode 1 and 2: VS Code's POST /auto routing, with one picker model per tier",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target node --format esm",
    "dev": "bun build ./src/index.ts --outfile ./dist/index.js --target node --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build && bun test"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.2",
    "@opencode-ai/sdk": "1.19.2",
    "@opencode/plugin": "2.0.30",
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "github-copilot",
    "copilot-auto",
    "auto-model"
  ],
  "license": "MIT",
  "author": "Kristof Lemmens (KL Consultancy)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klconsultancy/opencode-copilot-auto.git"
  },
  "bugs": {
    "url": "https://github.com/klconsultancy/opencode-copilot-auto/issues"
  },
  "homepage": "https://github.com/klconsultancy/opencode-copilot-auto#readme",
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "m0wer (original opencode-github-copilot-auto-model)"
  ]
}
